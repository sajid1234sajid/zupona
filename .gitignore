# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
.vinext/
.wrangler/

# The Android build is generated; only twa-manifest.json is source.
android/android.keystore
android/app/
android/build/
android/.gradle/
android/gradle*
android/*.apk
android/*.aab
android/*.keystore
android/store_icon.png
android/*.iml
android/local.properties
android/settings.gradle
