{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zupona",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  // The admin panel and the Seller Center are served by this same Worker,
  // chosen by Host header in src/proxy.ts -- `admin.zupona.com/products` is
  // rewritten to `/admin/products` internally, and `seller.zupona.com/settings`
  // to `/seller/settings`. Declaring them as custom domains (rather than route
  // patterns) makes Cloudflare create the DNS records and the TLS certificates
  // for them.
  //
  // Every host here has to be listed, not only the ones that serve pages: the
  // proxy redirects `/seller/*` on the apex to the seller subdomain, so a
  // missing entry does not merely leave a subdomain unused -- it breaks the
  // link that sends people there.
  //
  // The apex serves the storefront. It previously pointed at an older Worker
  // named "asdf", which is still deployed but no longer bound to any hostname
  // -- re-attaching zupona.com to it is how you would roll back.
  "routes": [
    {
      "pattern": "zupona.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.zupona.com",
      "custom_domain": true
    },
    {
      "pattern": "seller.zupona.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Workers Cache is off, and must be written as `false` rather than deleted:
  // wrangler only sends the setting when the key is present, so removing it
  // would leave the old `true` in place on Cloudflare. With it on, the edge
  // stored every page after its first visit -- despite `no-store` -- and
  // replayed it as an empty 503, which took the whole shop down. No page here
  // is cacheable anyway, so it bought nothing.
  "cache": {
    "enabled": false
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Primary relational store: users, sellers, catalog, orders, payments.
  // Schema lives in db/schema.sql (fresh installs) + db/migrations/ (upgrades).
  // NOTE: the older "zupona-db" database belongs to a previous Zupona build
  // with an incompatible schema; it is left untouched as an archive.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zupona-v3-db",
      "database_id": "34714511-c7ec-4539-8db2-b0d0953bbdb5"
    }
  ],
  // Object storage for product images, seller KYC documents and review photos.
  // Database rows store the object key; the bytes live here.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zupona-product-media"
    }
  ],
  // Edge cache for hot reads (homepage/catalog queries), OTP throttling and
  // rate limiting -- keeps repeat traffic off D1.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d42d285e3d8a4f86a6bb8ea882fca621"
    }
  ],
  // Zupona Image Fit (apps/image-fit, fit.zupona.com): paints the space
  // around a product picture so it fills the 4:5 frame. Reached over RPC, so
  // it is never exposed to the internet through this Worker and needs no key.
  // That Worker must exist before this one deploys with the binding.
  "services": [
    {
      "binding": "IMAGE_FIT",
      "service": "zupona-image-fit",
      "entrypoint": "ImageFit"
    }
  ]
}
